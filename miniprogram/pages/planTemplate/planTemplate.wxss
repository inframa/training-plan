.pt-section-title {
  margin-bottom: 20rpx;
}
.pt-section-title .muted {
  margin-top: 4rpx;
}
.pt-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.pt-card {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}
.pt-card:active {
  background: #f7f9fc;
}
.pt-color {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.pt-card-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.pt-card-desc {
  font-size: 24rpx;
  line-height: 1.4;
}
.pt-tip {
  text-align: center;
  margin-top: 48rpx;
  font-size: 22rpx;
}
