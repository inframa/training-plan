<view class="page mine">
  <!-- 用户信息卡 -->
  <view class="card mine-user">
    <!-- 头像：微信 chooseAvatar 组件（自动内容安全审核） -->
    <button class="mine-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="mine-avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="mine-avatar">我</view>
    </button>
    <view class="mine-user-info">
      <view class="h2">健身爱好者</view>
      <view wx:if="{{isLocalUser}}" class="muted">本地临时用户（未登录）</view>
      <view wx:else class="mine-openid-row">
        <text class="muted" style="word-break:break-all">openid：{{openid || '加载中…'}}</text>
        <text class="mine-copy-btn" bindtap="onCopyOpenid">复制</text>
      </view>
    </view>
  </view>

  <!-- 训练统计 -->
  <view class="card">
    <view class="h2" style="margin-bottom: 24rpx">训练统计</view>
    <view class="mine-stats">
      <view class="mine-stat">
        <view class="num">{{trainingDays}}</view>
        <view class="muted">已训练天数</view>
      </view>
      <view class="mine-stat">
        <view class="num">{{totalVolume}}</view>
        <view class="muted">累计容量 kg·次</view>
      </view>
    </view>
  </view>

  <!-- 同步状态 -->
  <view class="card">
    <view class="h2" style="margin-bottom: 24rpx">数据同步</view>
    <view class="mine-row row between">
      <text class="muted">同步状态</text>
      <text class="mine-sync {{syncStatus === '已同步' ? 'ok' : 'pending'}}">{{syncStatus}}</text>
    </view>
    <view class="mine-row row between">
      <text class="muted">最后登录</text>
      <text class="muted">{{lastLogin}}</text>
    </view>
    <view class="btn plain" style="margin-top: 16rpx" bindtap="onRetrySync">立即同步</view>
  </view>

  <!-- 设置 -->
  <view class="card">
    <view class="h2" style="margin-bottom: 24rpx">设置</view>
    <view class="mine-row row between" bindtap="onFeedback">
      <text>意见反馈</text>
      <text class="muted">›</text>
    </view>
    <view class="mine-row row between" bindtap="onManagePartTree">
      <text>身体部位分类管理</text>
      <text class="muted">›</text>
    </view>
    <view class="mine-row row between" bindtap="onRetrySync">
      <text>同步待上传数据</text>
      <text class="muted">›</text>
    </view>
    <view class="mine-row row between" bindtap="onClearCache">
      <text class="danger">清除本地缓存</text>
      <text class="muted">›</text>
    </view>
  </view>

  <!-- 协议固定入口（审核要求） -->
  <view class="card">
    <view class="mine-row row between" bindtap="onViewTerms">
      <text>用户服务协议</text>
      <text class="muted">›</text>
    </view>
    <view class="mine-row row between" bindtap="onViewPrivacy">
      <text>隐私政策</text>
      <text class="muted">›</text>
    </view>
    <view class="mine-row row between" bindtap="onReshowConsent">
      <text>协议同意状态</text>
      <text class="mine-sync {{consentAgreed ? 'ok' : 'pending'}}">{{consentAgreed ? '已同意' : '未同意'}}</text>
    </view>
    <!-- 紧急修复：已同意协议但仍是本地临时用户时显示手动登录按钮 -->
    <view wx:if="{{isLocalUser && consentAgreed}}" class="mine-row row between" bindtap="onManualLogin">
      <text class="mine-sync pending">⚠️ 本地临时用户，点击登录获取正式身份</text>
      <text class="muted">›</text>
    </view>
  </view>

  <view class="card">
    <view class="mine-row row between" bindtap="onAbout">
      <text>关于</text>
      <text class="muted">v1.0 ›</text>
    </view>
  </view>
</view>
