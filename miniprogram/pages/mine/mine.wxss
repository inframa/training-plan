.mine-user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #2e6be6, #5c8af5);
  color: #fff;
}
.mine-user .h2 {
  color: #fff;
}
.mine-nickname-input {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  min-width: 240rpx;
  max-width: 400rpx;
}
.mine-nickname-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}
.mine-login-prompt {
  border-left: 6rpx solid #07c160;
}
.mine-login-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.mine-user .muted {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
}
.mine-openid-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
}
.mine-openid-row .muted {
  flex: 1;
  font-size: 22rpx;
  font-family: Menlo, Consolas, monospace;
}
.mine-copy-btn {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.15);
}
.mine-avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
}
.mine-avatar-btn::after {
  border: none;
}
.mine-avatar-btn:active {
  opacity: 0.8;
}
.mine-avatar-btn .mine-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
}
.mine-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  line-height: 96rpx;
}
.mine-stats {
  display: flex;
  gap: 24rpx;
}
.mine-stat {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #f7f9fc;
  border-radius: 16rpx;
}
.mine-stat .num {
  font-size: 44rpx;
  color: #2e6be6;
}
.mine-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
  font-size: 28rpx;
}
.mine-row:last-child {
  border-bottom: none;
}
.mine-row.danger {
  color: #e5484d;
}
.mine-sync {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.mine-sync.ok {
  background: #e5f5eb;
  color: #2ba471;
}
.mine-sync.pending {
  background: #fef0e1;
  color: #e6912e;
}
