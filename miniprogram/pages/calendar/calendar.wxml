<view class="page cal">
  <view class="card cal-head">
    <view class="row between">
      <view class="arrow" bindtap="onPrevMonth">‹</view>
      <view class="h1">{{title}}</view>
      <view class="arrow" bindtap="onNextMonth">›</view>
    </view>
    <view class="row cal-meta">
      <text class="muted">已训练 {{monthMeta.trained}} 天</text>
      <text class="muted" wx:if="{{monthMeta.untrained}}"> · 未训练 {{monthMeta.untrained}} 天</text>
      <view class="flex1"></view>
      <text class="link" bindtap="onGoToday">回到今天</text>
    </view>
    <calendar-grid
      year="{{year}}"
      month="{{month}}"
      marks="{{marks}}"
      selected="{{selected}}"
      today="{{today}}"
      bind:select="onSelect"
      bind:futuretap="onFutureTap"
    />
    <view class="cal-legend">
      <view class="lg"><view class="dot blue"></view>已训练</view>
      <view class="lg"><view class="dot orange"></view>未训练</view>
      <view class="lg muted">点击日期查看 / 补录训练</view>
    </view>
  </view>

  <!-- 协议同意遮罩 -->
  <view wx:if="{{showConsent}}" class="consent-mask">
    <view class="consent-card">
      <view class="consent-title">欢迎使用</view>
      <view class="consent-subtitle">健身容量记录</view>
      <view class="consent-desc">在使用本小程序前，请先阅读并同意：</view>
      <view class="consent-links">
        <text class="consent-link" bindtap="onViewTerms">《用户服务协议》</text>
        <text class="consent-sep"> 和 </text>
        <text class="consent-link" bindtap="onViewPrivacy">《隐私政策》</text>
      </view>
      <view class="consent-desc consent-desc-detail">同意后，我们将获取您的微信身份标识（openid）用于数据存储与同步，不会收集其他敏感信息。</view>
      <view class="consent-btns">
        <button class="consent-btn-primary" bindtap="onAgreeConsent">我已阅读并同意</button>
        <button class="consent-btn-secondary" bindtap="onDisagreeConsent">暂不同意</button>
      </view>
    </view>
  </view>
</view>
