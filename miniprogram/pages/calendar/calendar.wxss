.cal-head {
  padding: 32rpx 24rpx;
}
.arrow {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f2f3f7;
  color: #4a5058;
  text-align: center;
  line-height: 60rpx;
  font-size: 40rpx;
}
.cal-meta {
  margin: 20rpx 0 8rpx;
}
.cal-legend {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f1f5;
  font-size: 22rpx;
  color: #4a5058;
}
.lg {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.dot.blue {
  background: #2e6be6;
}
.dot.orange {
  background: #e6912e;
}
