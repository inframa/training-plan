.cal-head {
  padding: 32rpx 24rpx;
}
.arrow {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f2f3f7;
  color: #4a5058;
  text-align: center;
  line-height: 60rpx;
  font-size: 40rpx;
}
.cal-meta {
  margin: 20rpx 0 8rpx;
}
.cal-legend {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f1f5;
  font-size: 22rpx;
  color: #4a5058;
}
.lg {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.dot.blue {
  background: #2e6be6;
}
.dot.orange {
  background: #e6912e;
}

/* ---------- 协议同意遮罩 ---------- */
.consent-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.consent-card {
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 32rpx;
  box-sizing: border-box;
}
.consent-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1F2328;
  text-align: center;
  margin-bottom: 8rpx;
}
.consent-subtitle {
  font-size: 28rpx;
  color: #4E5969;
  text-align: center;
  margin-bottom: 32rpx;
}
.consent-desc {
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.7;
  text-align: center;
  margin-bottom: 20rpx;
}
.consent-links {
  text-align: center;
  margin-bottom: 24rpx;
}
.consent-link {
  font-size: 26rpx;
  color: #2E6BE6;
  text-decoration: underline;
}
.consent-sep {
  font-size: 26rpx;
  color: #4E5969;
}
.consent-desc-detail {
  font-size: 24rpx;
  color: #8A94A6;
  margin-bottom: 36rpx;
  padding: 0 16rpx;
}
.consent-btns {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.consent-btn-primary {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2E6BE6;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  padding: 0;
  margin: 0;
}
.consent-btn-primary::after {
  border: none;
}
.consent-btn-secondary {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2F3F7;
  color: #4E5969;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  padding: 0;
  margin: 0;
}
.consent-btn-secondary::after {
  border: none;
}
