.privacy {
  padding: 32rpx;
  background: #FFFFFF;
  min-height: 100vh;
  box-sizing: border-box;
}
.section {
  margin-bottom: 32rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1F2328;
  margin-bottom: 12rpx;
  text-align: center;
}
.update-date {
  font-size: 24rpx;
  color: #9AA3AE;
  text-align: center;
  margin-bottom: 24rpx;
}
.h1 {
  font-size: 30rpx;
  font-weight: bold;
  color: #1F2328;
  margin-bottom: 16rpx;
}
.sub {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}
.p {
  font-size: 28rpx;
  color: #4E5969;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}
.list {
  padding-left: 16rpx;
}
.item {
  font-size: 28rpx;
  color: #4E5969;
  line-height: 1.8;
  margin-bottom: 12rpx;
}
