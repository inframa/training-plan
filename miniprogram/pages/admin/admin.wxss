.admin-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}
.admin-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4a5058;
}
.admin-tab.on {
  background: #2e6be6;
  color: #fff;
  font-weight: 500;
}
.admin-item {
  padding: 24rpx;
}
.admin-content {
  font-size: 28rpx;
  line-height: 1.5;
  margin: 14rpx 0 12rpx;
  color: #1f2329;
  background: #f7f9fc;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  word-break: break-all;
}
.admin-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 8rpx;
}
.admin-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.admin-actions .btn.sm {
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  min-width: auto;
}
.btn.danger {
  background: #e5484d;
  color: #fff;
}
.btn.plain {
  background: #eef2fb;
  color: #2e6be6;
}
