/* app.wxss 全局样式 */
page {
  background: #f5f6fa;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ---- 布局 ---- */
.page {
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
}
.row {
  display: flex;
  align-items: center;
}
.between {
  justify-content: space-between;
}
.flex1 {
  flex: 1;
  min-width: 0;
}

/* ---- 卡片 ---- */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

/* ---- 文本 ---- */
.h1 {
  font-size: 36rpx;
  font-weight: 600;
}
.h2 {
  font-size: 32rpx;
  font-weight: 600;
}
.muted {
  color: #8a9099;
  font-size: 24rpx;
}
.link {
  color: #2e6be6;
  font-size: 24rpx;
}
.link.danger {
  color: #e5484d;
}
.num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
}

/* ---- 按钮 ---- */
.btn {
  background: #2e6be6;
  color: #fff;
  border-radius: 16rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 500;
}
.btn.plain {
  background: #eef3ff;
  color: #2e6be6;
}
.btn.disabled {
  opacity: 0.5;
}
.btn-danger {
  background: #fdeced;
  color: #e5484d;
  border-radius: 16rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
}

/* ---- 标签 chip ---- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #f2f3f7;
  color: #4a5058;
  font-size: 26rpx;
}
.chip.on {
  background: #e8f0ff;
  color: #2e6be6;
  font-weight: 500;
}

/* ---- 输入 ---- */
.input {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.field {
  margin-bottom: 20rpx;
}
.field-label {
  font-size: 26rpx;
  color: #4a5058;
  margin-bottom: 10rpx;
}
.field-error {
  border: 2rpx solid #e5484d;
}

/* ---- 空态 ---- */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #8a9099;
}
.empty-title {
  font-size: 32rpx;
  color: #4a5058;
  margin-bottom: 12rpx;
}

/* ---- 悬浮按钮 ---- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #2e6be6;
  color: #fff;
  font-size: 60rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(46, 107, 230, 0.35);
}

/* ---- 遮罩弹层 ---- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}
.popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ---- 缩略图占位 ---- */
.thumb-ph {
  background: #eef0f4;
  color: #b3b9c3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}
