/* 竖排多级分类树 */
:host {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

.ctree-scroll {
  flex: 1;
  min-height: 0;
}

.ctree-row {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding-right: 8rpx;
  border-left: 6rpx solid transparent;
  font-size: 28rpx;
  color: #333;
  position: relative;
}

.ctree-row-hover {
  background: #F5F7FA;
}

.ctree-row.is-selected {
  border-left-color: #2E6BE6;
  background: #EDF3FE;
  color: #2E6BE6;
  font-weight: 600;
}

.ctree-row.is-virtual {
  /* 虚拟行：弱化视觉，跟子菜单同级 */
  color: #666;
}

.ctree-row.is-dragging {
  opacity: 0.35;
}

.ctree-row.is-target {
  border-bottom: 4rpx solid #2E6BE6;
}

.ctree-row.is-target::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2rpx;
  height: 4rpx;
  background: #2E6BE6;
  pointer-events: none;
}

.ctree-label {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.muted {
  color: #9AA3AE;
}

.ctree-arrow {
  flex-shrink: 0;
  width: 40rpx;
  text-align: center;
  color: #9AA3AE;
  font-size: 24rpx;
}

.ctree-arrow-placeholder {
  visibility: hidden;
}

/* 内联折叠/展开图标：跟子菜单同一行内 */
.ctree-icon-btn-inline {
  flex-shrink: 0;
  width: 40rpx;
  text-align: center;
  color: #2E6BE6;
  font-size: 26rpx;
}

.ctree-ops {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.ctree-op {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 30rpx;
}

.ctree-op.drag-handle {
  color: #9AA3AE;
  background: transparent;
  font-size: 34rpx;
  letter-spacing: 2rpx;
}

.ctree-op.add {
  color: #2E6BE6;
  background: #EDF3FE;
}

.ctree-op.del {
  color: #E5484D;
  background: #FDECEC;
}

.ctree-foot {
  flex-shrink: 0;
  display: flex;
  border-top: 1rpx solid #EEF0F4;
  background: #FAFBFC;
}

.ctree-foot-btn {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #666;
}

.ctree-foot-btn.primary {
  color: #2E6BE6;
  font-weight: 600;
}
