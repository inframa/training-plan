<scroll-view
  scroll-y="{{!dragging}}"
  class="ctree-scroll"
  bindscroll="onScroll"
  bindtouchstart="onTouchStart"
  bindtouchmove="onTouchMove"
  bindtouchend="onTouchEnd"
>
  <!-- 管理模式顶部工具栏：添加顶级 + 折叠/展开 -->
  <view wx:if="{{editable && managing}}" class="ctree-toolbar">
    <view class="ctree-tool-btn ctree-add-top" bindtap="onAddTop">
      <text class="ctree-add-icon">＋</text>
      <text class="ctree-add-label">添加顶级</text>
    </view>
    <view class="ctree-tool-btn" bindtap="onCollapseAll">全部折叠</view>
    <view class="ctree-tool-btn" bindtap="onExpandAll">全部展开</view>
  </view>

  <view
    wx:for="{{rows}}"
    wx:key="path"
    wx:for-index="idx"
    class="ctree-row {{item.selected ? 'is-selected' : ''}} {{dragging && dragPath === item.path ? 'is-dragging' : ''}} {{dragging && targetIdx === idx && dragPath !== item.path ? 'is-target' : ''}}"
    style="padding-left: {{12 + item.depth * 18}}rpx"
    data-path="{{item.path}}"
    data-label="{{item.label}}"
    data-idx="{{idx}}"
    bindtap="onTap"
    bindlongpress="onLongPress"
    catchtouchstart="onRowTouchStart"
  >
    <text
      wx:if="{{item.hasChildren}}"
      class="ctree-arrow"
      catchtap="onArrow"
      data-path="{{item.path}}"
    >{{item.expanded ? '▾' : '▸'}}</text>
    <text wx:else class="ctree-arrow ctree-arrow-placeholder"></text>
    <text class="ctree-label">{{item.label}}</text>
    <view wx:if="{{managing}}" class="ctree-ops" catchtap="noop">
      <text class="ctree-op drag-handle" catchtouchstart="onDragStart" data-path="{{item.path}}" data-label="{{item.label}}" data-idx="{{idx}}">≡</text>
      <text class="ctree-op add" catchtap="onAddChild" data-path="{{item.path}}">＋</text>
      <text class="ctree-op del" catchtap="onDelete" data-path="{{item.path}}" data-label="{{item.label}}">×</text>
    </view>
  </view>
</scroll-view>
<view wx:if="{{editable}}" class="ctree-foot">
  <text class="ctree-foot-btn primary" bindtap="onToggleManage">{{managing ? '完成' : '管理'}}</text>
  <text class="ctree-foot-btn" bindtap="onReset">恢复默认</text>
</view>
