<scroll-view
  scroll-y="{{!dragging}}"
  class="ctree-scroll"
  bindscroll="onScroll"
  bindtouchmove="onTouchMove"
  bindtouchend="onTouchEnd"
>
  <view
    wx:for="{{rows}}"
    wx:key="path"
    wx:for-index="idx"
    class="ctree-row {{item.path === '__all__' ? 'is-all' : ''}} {{item.selected ? 'is-selected' : ''}} {{dragging && dragPath === item.path ? 'is-dragging' : ''}} {{dragging && targetIdx === idx && dragPath !== item.path ? 'is-target' : ''}}"
    style="padding-left: {{12 + item.depth * 18}}rpx"
    data-path="{{item.path}}"
    data-label="{{item.label}}"
    data-idx="{{idx}}"
    bindtap="onTap"
    hover-class="ctree-row-hover"
  >
    <!-- 「全部」行：管理模式下右侧显示「添加根节点」 -->
    <block wx:if="{{item.path === '__all__'}}">
      <text
        wx:if="{{item.hasChildren}}"
        class="ctree-arrow ctree-arrow-all"
        catchtap="onArrow"
        data-path="{{item.path}}"
      >{{item.expanded ? '▾' : '▸'}}</text>
      <text wx:else class="ctree-arrow ctree-arrow-placeholder"></text>
      <text class="ctree-label">{{item.label}}</text>
      <view wx:if="{{managing}}" class="ctree-add-root" catchtap="onAddTop">＋</view>
    </block>

    <!-- 普通分类行 -->
    <block wx:else>
      <text
        wx:if="{{item.hasChildren}}"
        class="ctree-arrow"
        catchtap="onArrow"
        data-path="{{item.path}}"
      >{{item.expanded ? '▾' : '▸'}}</text>
      <text wx:else class="ctree-arrow ctree-arrow-placeholder"></text>
      <text class="ctree-label">{{item.label}}</text>
      <view wx:if="{{managing}}" class="ctree-ops" catchtap="noop">
        <text class="ctree-op drag-handle" catchtouchstart="onDragStart" data-path="{{item.path}}" data-label="{{item.label}}" data-idx="{{idx}}">≡</text>
        <text class="ctree-op add" catchtap="onAddChild" data-path="{{item.path}}">＋</text>
        <text class="ctree-op del" catchtap="onDelete" data-path="{{item.path}}" data-label="{{item.label}}">×</text>
      </view>
    </block>
  </view>
</scroll-view>
<view wx:if="{{editable}}" class="ctree-foot">
  <text class="ctree-foot-btn primary" bindtap="onToggleManage">{{managing ? '完成' : '管理'}}</text>
  <text wx:if="{{managing}}" class="ctree-foot-btn" bindtap="onReset">恢复默认</text>
</view>
