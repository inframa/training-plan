.ip {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ip-item {
  width: 168rpx;
  height: 168rpx;
  border-radius: 14rpx;
  position: relative;
  overflow: hidden;
}
.ip-img {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}
.ip-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ip-retry {
  color: #fff;
  font-size: 24rpx;
}
.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.ip-del {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  text-align: center;
  line-height: 36rpx;
  font-size: 30rpx;
}
.ip-add {
  background: #f2f3f7;
  color: #b3b9c3;
  font-size: 64rpx;
  text-align: center;
  line-height: 150rpx;
}
