.cg-head {
  display: flex;
  margin-bottom: 8rpx;
}
.cg-wk {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #8a9099;
  padding: 8rpx 0;
}
.cg-row {
  display: flex;
}
.cg-cell {
  flex: 1;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 10rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.cg-cell.selected {
  background: #e8f0ff;
}
.cg-day {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 50%;
}
.cg-day.today {
  background: #2e6be6;
  color: #fff;
  font-weight: 600;
}
.cg-cell.future .cg-day {
  color: #c3c8cf;
}
.cg-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-top: 6rpx;
  background: #e6912e;
}
.cg-dot.trained {
  background: #2e6be6;
}
.cg-info {
  font-size: 18rpx;
  color: #4a5058;
  margin-top: 4rpx;
  line-height: 26rpx;
  max-width: 94%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cg-cell.future .cg-info {
  color: #c3c8cf;
}
