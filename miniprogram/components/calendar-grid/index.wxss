.cg-head {
  display: flex;
  margin-bottom: 8rpx;
}
.cg-wk {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #8a9099;
  padding: 8rpx 0;
}
.cg-row {
  display: flex;
}
.cg-cell {
  flex: 1;
  height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 12rpx 6rpx 8rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.cg-cell.selected {
  background: #e8f0ff;
}
.cg-day {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 50%;
}
.cg-day.today {
  background: #2e6be6;
  color: #fff;
  font-weight: 600;
}
.cg-cell.future .cg-day {
  color: #c3c8cf;
}
.cg-title-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  width: 100%;
  justify-content: center;
  gap: 6rpx;
}
.cg-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e6912e;
}
.cg-dot.trained {
  background: #2e6be6;
}
.cg-title {
  font-size: 22rpx;
  line-height: 28rpx;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 500;
}
.cg-title.trained {
  color: #2e6be6;
}
.cg-title.untrained {
  color: #e6912e;
}
.cg-volume {
  font-size: 18rpx;
  color: #8a9099;
  line-height: 24rpx;
  margin-top: 4rpx;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cg-cell.future .cg-title,
.cg-cell.future .cg-volume {
  color: #c3c8cf;
}
