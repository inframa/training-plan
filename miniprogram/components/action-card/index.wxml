<view class="ac {{selected ? 'ac-sel' : ''}}" wx:if="{{action}}" bindtap="onTap">
  <image wx:if="{{thumb}}" class="ac-thumb" src="{{thumb}}" mode="aspectFill" lazy-load="{{true}}" />
  <view wx:else class="ac-thumb thumb-ph">无图</view>
  <view class="ac-main">
    <view class="ac-name">{{action.name}}</view>
    <view class="ac-meta muted">{{partsText}}</view>
    <view class="ac-meta muted" wx:if="{{metaText}}">{{metaText}}</view>
  </view>
  <view class="ac-right">
    <view class="ac-type">{{typeLabel}}</view>
    <view class="ac-check" wx:if="{{selected}}"></view>
  </view>
</view>
